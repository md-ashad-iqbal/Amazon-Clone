# Amazon Clone Environment Variables Example
NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/amazon-clone?retryWrites=true&w=majority
# If omitted or unavailable, the backend automatically runs in resilient in-memory mock mode.
MONGODB_URI=

# JWT Authentication Secret
JWT_SECRET=amazon-clone-super-secure-production-jwt-secret-replace-me-32chars

# Client Application URL (for CORS if deploying backend independently)
CLIENT_URL=http://localhost:5173
